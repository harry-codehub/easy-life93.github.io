# .env.local
# All variables below are OPTIONAL. Without them the site still works and the
# contact page shows direct email / LinkedIn links instead of the form.

# disabled next.js telemetry
NEXT_TELEMETRY_DISABLED="1"

# resend (sends contact-form emails)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="Harold Johnson <hello@your-domain.com>"
CONTACT_TO_EMAIL="harold.johnson0918@gmail.com"
CONTACT_SITE_URL="https://harold-johnson.vercel.app"
RESEND_TEMPLATE_CONTACT_USER="contact-thank-you"
RESEND_TEMPLATE_CONTACT_ADMIN="contact-admin"

# google recaptcha v3 (spam protection for the contact form)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
RECAPTCHA_SECRET_KEY="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
RECAPTCHA_MIN_SCORE="0.5"
